{
  "name": "@muster/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "npm run build --workspace @muster/shared && node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "npm run build --workspace @muster/shared && vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@muster/shared": "0.1.0",
    "hono": "^4.13.0",
    "zod": "^4.6.0"
  }
}
