{
  "name": "@muster/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "npm run build --workspace @muster/shared && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
