{
  "name": "muster",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wale-Shi/Muster.git"
  },
  "homepage": "https://github.com/Wale-Shi/Muster#readme",
  "bugs": {
    "url": "https://github.com/Wale-Shi/Muster/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/daemon",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run build --workspace @muster/shared && node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "daemon": "npm run build --workspace @muster/shared && npm run build --workspace @muster/daemon && node apps/daemon/dist/index.js start --server http://127.0.0.1:7420",
    "start": "node apps/server/dist/index.js",
    "e2e": "node scripts/e2e.mjs",
    "mac": "npm run build && apps/macos/scripts/bundle.sh",
    "mac:test": "swift test --package-path apps/macos"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
