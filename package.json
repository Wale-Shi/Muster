{
  "name": "muster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/daemon",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
